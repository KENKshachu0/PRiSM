{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prism-platform",
  "main": "packages/server/src/worker.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_BILLING",
        "class_name": "LiveBilling"
      },
      {
        "name": "MACHINE_RELAY",
        "class_name": "MachineRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "live-billing-v1",
      "new_sqlite_classes": [
        "LiveBilling"
      ]
    },
    {
      "tag": "machine-relay-v1",
      "new_sqlite_classes": [
        "MachineRelay"
      ]
    }
  ],
  "compatibility_date": "2026-06-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "packages/prism-web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/t/*/*",
      "/.well-known/*",
      "/callback*",
      "/io/*"
    ],
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prism-platform",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:8787",
    "EXTRA_ALLOWED_ORIGINS": "http://localhost:5173",
    "MUNET_CLIENT_ID": "",
    "APNS_KEY_ID": "",
    "APNS_TEAM_ID": ""
  },
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMIT_3",
      "namespace_id": "73003",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_5",
      "namespace_id": "73005",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_10",
      "namespace_id": "73010",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_20",
      "namespace_id": "73020",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_30",
      "namespace_id": "73030",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_60",
      "namespace_id": "73060",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "limits": {
    "cpu_ms": 1000
  },
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
